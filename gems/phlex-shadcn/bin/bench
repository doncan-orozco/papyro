#!/usr/bin/env ruby
# frozen_string_literal: true

# Render benchmark: microseconds and object allocations per render of representative components, plain Phlex, no Rails.
#   bin/bench                 print the table
#   bin/bench --json          print the numbers as JSON ({scenario => {us, allocations}})
#   bin/bench --check         compare allocations with dev/bench/baseline.json; exit 1 when a scenario exceeds baseline + tolerance
#   bin/bench --record        rewrite dev/bench/baseline.json with today's allocations
# Time is reported but never gated (flaky); allocations per render are the gate. The implementation lives in dev/bench/.
require_relative "../dev/bench/runner"

exit Bench::Runner.call(ARGV)
