#!/usr/bin/env bash
# Local equivalents of the chadcn gem CI checks that are cheap to forget and expensive to find on a PR (YARD 100%, a gem build
# without warnings, the plain-Phlex smoke, the docs fences, the other Ruby versions and the Phlex 2.3 gemfile of the CI matrix).
#
#   bin/pre-review [--gem-dir DIR] [--rubies 3.3,3.4] [--skip STEP,...] [--dry-run]
#
# STEP is one of: yard, build, smoke, docs, rubies. A ruby of --rubies that is not installed (rbenv) is reported and skipped, never
# silently passed. Exit 0 when every step that ran is green, 1 when one is red. --dry-run only prints the steps.
# BUNDLE_GEMFILE of the shell is ignored on purpose (a stray one fakes red gates); each step sets its own.
set -uo pipefail

# The gem is a sibling checkout of the main repository (a worktree lives deeper, so go through the common git dir).
main_root="$(cd "$(git -C "$(dirname "$0")" rev-parse --git-common-dir)/.." && pwd)"
gem_dir="${PRE_REVIEW_GEM_DIR:-$main_root/../chadcn}"
rubies="3.3,3.4"
skip=""
dry_run=0

while [ $# -gt 0 ]; do
  case "$1" in
    --gem-dir) gem_dir="${2:?--gem-dir needs a value}"; shift 2 ;;
    --rubies) rubies="${2:?--rubies needs a value}"; shift 2 ;;
    --skip) skip="${2:?--skip needs a value}"; shift 2 ;;
    --dry-run) dry_run=1; shift ;;
    -h|--help) sed -n '2,10p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "pre-review: unknown option $1" >&2; exit 2 ;;
  esac
done

[ -d "$gem_dir" ] || { echo "pre-review: gem directory $gem_dir not found (--gem-dir)" >&2; exit 2; }
gem_dir="$(cd "$gem_dir" && pwd)"
unset BUNDLE_GEMFILE

failed=0
skipped_step() { case ",$skip," in *",$1,"*) return 0 ;; *) return 1 ;; esac; }

# step NAME DESCRIPTION CMD...: runs CMD in the gem directory with the gem's own Gemfile.
step() {
  local name="$1" label="$2"
  shift 2
  if skipped_step "$name"; then echo "pre-review: skip   $name"; return; fi
  if [ "$dry_run" -eq 1 ]; then echo "pre-review: would  $name - $label"; return; fi
  echo "pre-review: run    $name - $label"
  if (cd "$gem_dir" && BUNDLE_GEMFILE="$gem_dir/Gemfile" "$@"); then
    echo "pre-review: ok     $name"
  else
    echo "pre-review: FAILED $name" >&2
    failed=1
  fi
}

yard_check() {
  local log
  log="$(mktemp)"
  bundle exec yard stats --list-undoc | tee "$log"
  grep -q '100.00% documented' "$log"
  local rc=$?
  rm -f "$log"
  return $rc
}

build_check() {
  local log
  log="$(mktemp)"
  gem build chadcn.gemspec 2>&1 | tee "$log"
  ! grep -qi warning "$log"
  local rc=$?
  rm -f "$log" chadcn-*.gem
  return $rc
}

step yard "public API fully documented (YARD 100%)" yard_check
step build "gem builds without warnings" build_check
step smoke "plain-Phlex smoke (Rails not loaded)" bundle exec bin/smoke --plain
step docs "every Ruby fence of README.md and docs/*.md renders" bundle exec bin/smoke --docs

# The CI matrix runs other Rubies; a render that works on 4.0 only is found there otherwise.
if skipped_step rubies; then
  echo "pre-review: skip   rubies"
else
  IFS=',' read -r -a versions <<< "$rubies"
  for v in "${versions[@]}"; do
    if [ "$dry_run" -eq 1 ]; then echo "pre-review: would  rubies - plain smoke on ruby $v"; continue; fi
    if ! command -v rbenv >/dev/null 2>&1 || ! rbenv versions --bare | grep -q "^${v}\."; then
      echo "pre-review: NOT RUN ruby $v is not installed (rbenv install $v); the CI matrix runs it" >&2
      continue
    fi
    echo "pre-review: run    rubies - plain smoke on ruby $v"
    if (cd "$gem_dir" && RBENV_VERSION="$(rbenv versions --bare | grep "^${v}\." | tail -1)" BUNDLE_GEMFILE="$gem_dir/test/smoke/gemfiles/phlex_2.3.gemfile" \
        sh -c 'rm -f "$BUNDLE_GEMFILE.lock"; bundle install --quiet && bundle exec bin/smoke --plain'); then
      echo "pre-review: ok     rubies $v"
    else
      echo "pre-review: FAILED rubies $v" >&2
      failed=1
    fi
  done
fi

exit "$failed"
