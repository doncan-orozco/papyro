# Example environment variables for local development.
# Copy this file to `.env` and fill in real values.
# Values here are *not* secrets; do not store sensitive data.

# ## Rails environment (used by the app and by tests)
# RAILS_ENV=development
# PORT=3030

# # set to true on CI servers to speed up boot
# CI=false

# ## feature flags / runtime configuration
# SOLID_QUEUE_IN_PUMA=true
# WEB_CONCURRENCY=1
# JOB_CONCURRENCY=1
