<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <title><%= content_for(:title) || "Papyro Studio" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">

    <script>
      (function(){
        var t=localStorage.getItem("papyro-theme"),d=document.documentElement;
        d.dataset.theme=t||"system";
        if(t==="dark"||(t==null&&window.matchMedia("(prefers-color-scheme: dark)").matches)){d.classList.add("dark");}
        else if(t==="light"){d.classList.add("light");}
      })();
    </script>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-dvh bg-background text-foreground antialiased">
    <%= content_for(:flash) || render(Components::Shared::Flash.new(flash: flash)) %>
    <%= render Components::Studio::Navbar.new %>

    <main id="main-content">
      <%= yield %>
    </main>
  </body>
</html>
