<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <title><%= content_for?(:page_title) ? "#{yield(:page_title)} | Papyro" : "Papyro" %></title>
    <meta name="description" content="<%= content_for?(:meta_description) ? yield(:meta_description) : t("seo.site_description") %>">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Papyro">
    <meta name="mobile-web-app-capable" content="yes">
    <meta property="og:title" content="<%= content_for?(:page_title) ? "#{yield(:page_title)} | Papyro" : "Papyro" %>">
    <meta property="og:description" content="<%= content_for?(:meta_description) ? yield(:meta_description) : t("seo.site_description") %>">
    <meta property="og:image" content="<%= content_for?(:og_image) ? yield(:og_image) : "#{request.base_url}/icon.png" %>">
    <meta name="twitter:card" content="summary_large_image">
    <meta property="og:locale" content="<%= og_locale %>">
    <% I18n.available_locales.each do |locale| %>
      <% next if locale.to_sym == I18n.locale.to_sym %>
      <meta property="og:locale:alternate" content="<%= og_locale_for(locale) %>">
    <% end %>
    <% unless content_for?(:suppress_seo_links) %>
      <link rel="canonical" href="<%= canonical_url %>">
      <% I18n.available_locales.each do |locale| %>
        <link rel="alternate" hreflang="<%= locale %>" href="<%= alternate_locale_url(locale) %>">
      <% end %>
      <link rel="alternate" hreflang="x-default" href="<%= x_default_url %>">
    <% end %>



    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%# Restore the user's theme preference before first paint to avoid FOUC %>
    <script>
      (function(){
        var t=localStorage.getItem("papyro-theme"),d=document.documentElement;
        d.dataset.theme=t||"system";
        if(t==="dark"||(t==null&&window.matchMedia("(prefers-color-scheme: dark)").matches)){d.classList.add("dark");}
        else if(t==="light"){d.classList.add("light");}
      })();
    </script>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <%= content_for(:flash) || render(Components::Shared::Flash.new(flash: flash)) %>
    <main id="main-content">
      <%= yield %>
    </main>
  </body>
</html>
